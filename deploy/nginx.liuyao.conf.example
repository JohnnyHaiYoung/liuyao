# nginx 反向代理示例：六爻 Agent（第一阶段）
#
# 关键点（否则流式会变成“转圈到结束才一次显示”）：
#   1. proxy_buffering off;   关闭响应缓冲
#   2. proxy_cache off;       不缓存聊天响应
#   3. gzip off;              SSE 不做压缩
#   4. 放宽 proxy_read_timeout，思考模式首段可能较慢
#   5. 透传 Host 与 X-Forwarded-Proto，应用据此决定 Cookie 是否加 Secure
#
# 来源 IP 信任链（验收报告 2026-10-02 第 2 条）：
#   - 应用默认**不信任** X-Forwarded-For / X-Real-IP（它们可被客户端伪造）。
#   - 只有在应用只监听 127.0.0.1、且本代理**覆盖写入** X-Real-IP 的前提下，
#     才在服务器上设置 LIUYAO_TRUST_PROXY=1，让登录限流按真实来源 IP 分桶。
#   - 因此这里用 `$remote_addr` **覆盖**而不是 `$proxy_add_x_forwarded_for` 追加：
#     追加会保留客户端自带的头，任何按“第一段”取 IP 的实现都会被绕过。
#
# 把证书路径、域名和 upstream 端口按实际环境替换后放入 conf.d/。

upstream liuyao_app {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    server_name liuyao.example.com;
    # 强制使用 HTTPS：登录 Cookie 在 HTTPS 下会自动带 Secure
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name liuyao.example.com;

    ssl_certificate     /etc/letsencrypt/live/liuyao.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/liuyao.example.com/privkey.pem;

    # 单条消息上限 8000 字符，普通 JSON 体很小；这里只是兜底
    client_max_body_size 1m;

    # 聊天流式接口：必须关闭缓冲与压缩
    location /api/conversations/ {
        proxy_pass http://liuyao_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 覆盖写入来源地址（不要用 $proxy_add_x_forwarded_for，那会保留客户端伪造的值）
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding on;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    # 其余页面与普通 JSON 接口
    location / {
        proxy_pass http://liuyao_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    # 不要暴露运行时数据目录（应用本身也没有文件下载端点）
    location ~ ^/(storage|corpus|wiki|skills)/ {
        return 404;
    }
}
