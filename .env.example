# 六爻 Agent 环境变量模板（第一阶段：可持久保存的自由聊天网站）
#
# 用法：
#   1) 服务器部署：把需要的变量注入服务进程环境（systemd EnvironmentFile、容器 env 等）；
#   2) 本地开发：复制为 app/.env.local（Next.js 会自动加载该文件，且已被 .gitignore 忽略）。
#
# 安全约定：
#   - 这里只放占位符；真实密钥、密码哈希不得提交到 Git、不得写进代码/数据库/浏览器包。
#   - 浏览器只拿到 /api/healthz 里的 "是否已配置" 布尔值，永远拿不到密钥本身。

# ---------------------------------------------------------------------------
# 模型（阶段 1 只接 DeepSeek 官方 API 的 deepseek-flash）
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 思考强度：none 关闭思考（首段最快）；low / high / max 开启思考，high 为官方默认。
# 思考 token 计入输出用量；阶段 1 不把推理过程写入历史，只保存最终正文。
LLM_REASONING_EFFORT=high
# 单次回复的最大 token（含思考 token）。留空则使用官方默认（思考模式 64K）。
# LLM_MAX_OUTPUT_TOKENS=8192
# 上游请求超时（毫秒）
LLM_TIMEOUT_MS=180000

# 真实密钥只放这里（服务器环境变量），不要写进任何文件后提交。
# DEEPSEEK_API_KEY=sk-...

# ---------------------------------------------------------------------------
# 阶段 4 新增：阿里云百炼（千问 qwen3.7-plus）
# ---------------------------------------------------------------------------
# 只要配置了 QWEN_API_KEY 或 DASHSCOPE_API_KEY 其中之一，GET /api/models 就会同时列出
# qwen3.7-plus，页面出现模型选择器；未配置时只列 deepseek-flash（默认模型始终不变）。
# 服务端在提交消息时还会用 resolveProviderForModel 再校验一次，客户端无法伪造。
#
# QWEN_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...            # 与上一行等价，二者任一即可（阿里云控制台常给 DASHSCOPE_API_KEY 这个名字）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 一般无需修改
# QWEN_MODEL=qwen3.7-plus             # 一般无需修改
#
# 注意：
#   1) 这两个提供方的变量都**只在服务端读取**，不会进入浏览器包，也不会写进日志与 SSE 事件；
#   2) 上述 QWEN_* 由 app/src/server/llm/qwen.ts 直接读取（不经 app/src/server/config.ts）；
#   3) 修改 app/.env.local 后需要重启服务（next dev / next start）才会生效；
#   4) app/scripts/*.mjs 离线自检脚本**不会**自动读取 .env.local，需要时请在命令行显式传入环境变量。

# ---------------------------------------------------------------------------
# 拥有者账户（单用户）
# ---------------------------------------------------------------------------
LIUYAO_OWNER_USERNAME=owner
# 推荐：用 `npm run hash-password` 生成 scrypt 哈希后填这里（重启生效）。
# 格式为冒号分隔：scrypt:N:r:p:saltBase64:hashBase64
#   —— 刻意不用 `$` 分隔：Next 读 .env 文件时会对值做变量展开，
#      `scrypt$32768$8$1$...` 会被吃掉成 `scrypt==...`，导致登录永远失败。
# 若坚持用旧的 `$` 格式，在 .env 文件里必须把每个 `$` 写成 `\$`。
# LIUYAO_OWNER_PASSWORD_HASH=scrypt:32768:8:1:xxxxxxxxxxxxxxxxxxxxxx==:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy==
# 备选：直接提供明文密码，服务在启动引导时立即哈希入库，数据库里不会有明文。
# LIUYAO_OWNER_PASSWORD=

# 登录会话
LIUYAO_SESSION_TTL_DAYS=30
# Cookie Secure 策略：auto（按请求协议自动判断，默认）/ always / never
LIUYAO_COOKIE_SECURE=auto
# LIUYAO_SESSION_COOKIE=liuyao_session

# ---------------------------------------------------------------------------
# 存储与上下文预算
# ---------------------------------------------------------------------------
# 运行时数据目录（数据库、备份、日志）。默认 <项目根>/storage。
# 部署时必须把它放在持久化卷/独立目录，升级应用时保留。
# LIUYAO_STORAGE_DIR=/srv/liuyao/storage
# 迁移目录（默认 <项目根>/app/migrations）
# LIUYAO_MIGRATIONS_DIR=

# 单条消息最大字符数
LIUYAO_MAX_MESSAGE_CHARS=8000
# 每次请求送给模型的最近消息条数（历史保存量与上下文预算分开）
LIUYAO_CONTEXT_MESSAGE_LIMIT=20
# 每次请求正文的字符预算上限
LIUYAO_CONTEXT_CHAR_BUDGET=40000
# 流式过程中把已生成文本写入数据库的间隔（毫秒）
LIUYAO_STREAM_PERSIST_INTERVAL_MS=1000

# 频率限制（进程内，单实例）
LIUYAO_LOGIN_MAX_ATTEMPTS=10
LIUYAO_LOGIN_WINDOW_MINUTES=15
LIUYAO_SENDS_PER_MINUTE=30

# 是否信任反向代理写入的来源头（X-Real-IP / X-Forwarded-For）。
# 默认 0：这些头可被客户端伪造，忽略它们、限流按单一来源计数。
# 仅在“应用只监听 127.0.0.1 + 代理覆盖写入 X-Real-IP”时才设为 1。
LIUYAO_TRUST_PROXY=0

# ---------------------------------------------------------------------------
# 本地验收开关（默认关闭，生产不得启用）
# ---------------------------------------------------------------------------
# =1 时注册本地「验收用假模型」（模型名 fake-stream-v1，不联网、不代表 DeepSeek 联调通过），
# 用于在没有真实密钥的机器上验证 SSE、停止生成与持久化链路。
# LIUYAO_FAKE_MODEL=0
# 显式指定项目根目录（部署时推荐，避免工作目录推断歧义）
# LIUYAO_PROJECT_ROOT=/srv/liuyao
