{
  "name": "liuyao-agent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Liuyao Agent 第一阶段：可持久保存的自由聊天网站（Next.js App Router + SQLite + DeepSeek Flash SSE）",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:info": "node scripts/db-info.mjs",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "check:wiki": "node scripts/build-wiki-catalog.mjs --check && node scripts/check-wiki-select.mjs && node scripts/check-source-reader.mjs",
    "check:chart": "node scripts/check-chart-service.mjs",
    "check:orchestration": "node scripts/check-orchestration.mjs",
    "check:e2e": "node --import ./scripts/lib/register-ts.mjs scripts/check-phase4-e2e.mjs",
    "check:vendor": "node scripts/check-paipan-vendor.mjs",
    "check:qwen": "node --import ./scripts/lib/register-ts.mjs scripts/check-qwen-adapter.mjs",
    "check:phase1-regression": "node scripts/check-phase1-regression.mjs",
    "check:provider-live": "node --import ./scripts/lib/register-ts.mjs scripts/check-provider-live.mjs",
    "check:provider-real": "node --import ./scripts/lib/register-ts.mjs scripts/check-provider-real-e2e.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check:migration-phase4": "node --import ./scripts/lib/register-ts.mjs scripts/check-migration-phase4.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lunar-typescript": "1.8.6",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
