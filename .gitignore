# 只排除体积大且含第三方版权的原件；其余资料产物（manifest、extracted、cleaned、assets、reports）
# 随仓库交付，避免"克隆仓库即丢失阶段 2 资料"。完整交接包（含原件）用
# tools/corpus-cli.ts pack 生成，清单与哈希见 docs/phase2_pack_inventory.md。
/corpus/originals/*
!/corpus/originals/README.md
/dist/

# Local credentials and Python environments
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc

# Node / Next.js application (dependencies are reinstalled from the lockfile)
/app/node_modules/
/app/.next/
/app/out/
/app/*.tsbuildinfo

# Local scratch space used while probing the toolchain
/.scratch-probe/
/.npm-cache/

# Runtime state: SQLite database, WAL files, backups and logs.
# It must be preserved on the server (persistent volume / separate directory),
# but it holds private chat records, so it is not committed.
/storage/*
!/storage/README.md
/storage/**/server-*.log
